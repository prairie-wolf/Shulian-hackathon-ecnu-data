#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$repo_root/scripts/commit_timestamp.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$repo_root/scripts/commit_timestamp.py" "$@"
else
    echo 'Commit timestamp hook: Python 3 is required; commit aborted.' >&2
    exit 1
fi
